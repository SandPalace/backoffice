 "lines": [
  {
   "at": 0.6,
   "out": 3.2,
   "text": "Dédalo construyó un laberinto.",
   "y": 1390
  },
  {
   "at": 3.4,
   "out": 5.7,
   "text": "El rey lo encerró en él,\ncon su hijo Ícaro.",
   "y": 1390
  },
  {
   "at": 5.9,
   "out": 7.5,
   "text": "Minos era dueño\nde la tierra y del mar.",
   "y": 1390
  },
  {
   "at": 7.7,
   "out": 9.4,
   "text": "Pero no del cielo.",
   "italic": true,
   "size": 112,
   "y": 1400
  },
  {
   "at": 10.0,
   "out": 12.6,
   "text": "Dédalo juntó plumas,",
   "y": 1400
  },
  {
   "at": 12.8,
   "out": 14.6,
   "text": "de la más corta\na la más larga,",
   "y": 1400
  },
  {
   "at": 14.8,
   "out": 17.2,
   "text": "y las unió con cera.",
   "italic": true,
   "y": 1400,
   "color": "gold"
  },
  {
   "at": 17.9,
   "out": 19.7,
   "text": "«Vuela por en medio»,\nle dijo.",
   "y": 1290,
   "bell": 69
  },
  {
   "at": 19.9,
   "out": 21.7,
   "text": "«Muy bajo, el mar\nmoja las alas.»",
   "y": 1290,
   "bell": 62
  },
  {
   "at": 21.9,
   "out": 23.7,
   "text": "«Muy alto, el sol\nderrite la cera.»",
   "y": 1290,
   "bell": 76
  },
  {
   "at": 24.4,
   "out": 26.3,
   "text": "Volaron.",
   "italic": true,
   "size": 124,
   "y": 1380
  },
  {
   "at": 26.6,
   "out": 28.4,
   "text": "Ícaro sintió el viento",
   "y": 1400
  },
  {
   "at": 28.6,
   "out": 31.1,
   "text": "y quiso más.",
   "italic": true,
   "size": 124,
   "y": 1380
  },
  {
   "at": 32.0,
   "out": 33.3,
   "text": "Subió.",
   "y": 1360,
   "size": 96
  },
  {
   "at": 33.4,
   "out": 34.7,
   "text": "Y subió.",
   "y": 1360,
   "size": 96
  },
  {
   "at": 34.8,
   "out": 37.3,
   "text": "Hasta sentir el sol.",
   "italic": true,
   "size": 112,
   "y": 1350,
   "color": "sunCore"
  },
  {
   "at": 37.7,
   "out": 41.7,
   "text": "La cera se derritió.",
   "y": 1380,
   "color": "gold"
  },
  {
   "at": 43.0,
