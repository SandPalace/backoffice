#!/usr/bin/env bash
# Comando `backoffice`: start | stop | status | update | backup | check | mcp-key | whatsapp
set -uo pipefail

# Resuelve la ruta real del repo aunque se llame por un symlink.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  D="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$D/$SELF" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

# AgentOS ahora se llama Back Office: por una versión, cada variable AGENTOS_* vale como su BACKOFFICE_* si esta falta
# (Claude pasa las de su configuración hasta que la migración las renombra y lo reinicias).
for _v in $(compgen -e | grep '^AGENTOS_'); do
  _n="BACKOFFICE_${_v#AGENTOS_}"; [ -n "${!_n:-}" ] || export "$_n=${!_v}"
done
unset _v _n

# Si moviste esta carpeta, Claude todavía pasa las rutas viejas (BACKOFFICE_HOME/BACKOFFICE_ROOT de su configuración) hasta que
# corres ./install.sh y lo reinicias: la carpeta data/ o workspaces/ de OTRA ubicación de Back Office no vale aquí (misma
# regla que install.sh y foreignPath() en scripts/migrate-plugins.mjs).
foreign_dir() { # <ruta> <data|workspaces>
  local x; [ "$(basename "$1")" = "$2" ] || return 1; x="$(dirname "$1")"
  [ -d "$x" ] && [ "$(cd "$x" && pwd -P)" = "$(cd "$REPO" && pwd -P)" ] && return 1
  [ -f "$x/.claude-plugin/marketplace.json" ] || [ ! -d "$x" ] || [ -z "$(ls -A "$x" 2>/dev/null | grep -vxE 'data|workspaces|\.DS_Store')" ]
}
if [ -n "${BACKOFFICE_HOME:-}" ] && foreign_dir "$BACKOFFICE_HOME" data; then unset BACKOFFICE_HOME; fi
if [ -n "${BACKOFFICE_ROOT:-}" ] && foreign_dir "$BACKOFFICE_ROOT" workspaces; then unset BACKOFFICE_ROOT; fi
# Datos en <repo>/data y workspaces en <repo>/workspaces (misma regla que el servidor: si solo existen las
# carpetas de una instalación anterior, ~/.agentos / ~/AgentOS, se siguen usando hasta migrarlas).
if [ -z "${BACKOFFICE_HOME:-}" ] && [ -d "$HOME/.agentos" ] && [ ! -d "$REPO/data" ]; then BACKOFFICE_HOME="$HOME/.agentos"; fi
if [ -z "${BACKOFFICE_ROOT:-}" ] && [ -d "$HOME/AgentOS" ] && [ ! -d "$REPO/workspaces" ]; then BACKOFFICE_ROOT="$HOME/AgentOS"; fi
BACKOFFICE_HOME="${BACKOFFICE_HOME:-$REPO/data}"
BACKOFFICE_ROOT="${BACKOFFICE_ROOT:-$REPO/workspaces}"
env_get1() { [ -f "$BACKOFFICE_HOME/.env" ] && grep -E "^$1=" "$BACKOFFICE_HOME/.env" | tail -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//"; }
# data/.env escrito antes del cambio de nombre tiene AGENTOS_*: vale igual que BACKOFFICE_* (una versión).
env_get() { local v; v="$(env_get1 "$1")"; [ -z "$v" ] && case "$1" in BACKOFFICE_*) v="$(env_get1 "AGENTOS_${1#BACKOFFICE_}")" ;; esac; printf '%s' "$v"; }
# Puertos de ESTE Back Office: los elige el instalador y viven en data/.env (cada empresa en su carpeta tiene los suyos:
# 4780/4781, 4782/4783, …). Una variable BACKOFFICE_PORT / BACKOFFICE_WEB_PORT puesta a mano gana.
PORT="${BACKOFFICE_PORT:-$(env_get BACKOFFICE_PORT)}"; PORT="${PORT:-4780}"
WEB_PORT="${BACKOFFICE_WEB_PORT:-$(env_get BACKOFFICE_WEB_PORT)}"; WEB_PORT="${WEB_PORT:-4781}"
RUN="$BACKOFFICE_HOME/run"; LOGS="$BACKOFFICE_HOME/logs"
SERVER_JS="$REPO/plugins/backoffice/server/src/server.mjs"
NEXT_BIN="$REPO/web/node_modules/next/dist/bin/next"
export BACKOFFICE_PORT="$PORT" BACKOFFICE_WEB_PORT="$WEB_PORT" BACKOFFICE_HOME BACKOFFICE_ROOT
# Empresa de esta carpeta (el servidor la usa para saber qué plugin es el suyo: backoffice-<slug>).
_slug="$(env_get BACKOFFICE_COMPANY_SLUG)"; [ -n "$_slug" ] && export BACKOFFICE_COMPANY_SLUG="$_slug"; unset _slug

say() { printf '%s\n' "$*"; }
healthy() { curl -fsS -m 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; }
web_up()  { curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$WEB_PORT/" 2>/dev/null; }
port_pid() { command -v lsof >/dev/null 2>&1 && lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null | head -1; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
pidof_file() { [ -f "$1" ] && cat "$1" 2>/dev/null; }

open_url() {
  [ "${BACKOFFICE_NO_OPEN:-}" = 1 ] && return 0
  if command -v open >/dev/null 2>&1; then open "$1" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

cmd_start() {
  mkdir -p "$RUN" "$LOGS"
  if [ ! -d "$REPO/web/.next" ]; then say "Falta compilar la web. Corre ./install.sh primero."; exit 1; fi
  if healthy; then say "Servidor ya estaba corriendo (puerto $PORT)."
  else
    if [ -n "$(port_pid "$PORT")" ]; then say "El puerto $PORT está ocupado por otro programa (¿otro Back Office?). Ciérralo o cambia BACKOFFICE_PORT y BACKOFFICE_WEB_PORT en data/.env y corre ./bin/backoffice update."; exit 1; fi
    nohup node "$SERVER_JS" >>"$LOGS/server.log" 2>&1 </dev/null &
    echo $! >"$RUN/server.pid"; disown 2>/dev/null || true
    for _ in $(seq 1 40); do healthy && break; sleep 0.25; done
    healthy || { say "El servidor no arrancó. Revisa $LOGS/server.log"; exit 1; }
    say "Servidor iniciado (puerto $PORT)."
  fi
  if web_up; then say "Oficina web ya estaba corriendo (puerto $WEB_PORT)."
  else
    if [ -n "$(port_pid "$WEB_PORT")" ]; then say "El puerto $WEB_PORT está ocupado por otro programa (¿otro Back Office?). Cambia BACKOFFICE_WEB_PORT en data/.env y corre ./bin/backoffice update."; exit 1; fi
    # Only node goes to the background (not a subshell that would keep this command's output open: Claude waits on it).
    (cd "$REPO/web" || exit 1; nohup node "$NEXT_BIN" start -p "$WEB_PORT" -H 127.0.0.1 >>"$LOGS/web.log" 2>&1 </dev/null & echo $! >"$RUN/web.pid")
    for _ in $(seq 1 80); do web_up && break; sleep 0.25; done
    web_up || { say "La web no arrancó. Revisa $LOGS/web.log"; exit 1; }
    say "Oficina web iniciada (puerto $WEB_PORT)."
  fi
  say "Abre: http://localhost:$WEB_PORT"
  open_url "http://localhost:$WEB_PORT"
}

stop_one() { # nombre pidfile puerto
  local pid pp stopped=0; pid="$(pidof_file "$2")"; pp="$(port_pid "$3")"
  for x in $pid $pp; do alive "$x" && kill "$x" 2>/dev/null && stopped=1; done
  for _ in 1 2 3 4 5 6 7 8; do [ -z "$(port_pid "$3")" ] && break; sleep 0.25; done
  [ "$stopped" = 1 ] && say "$1 detenido." || say "$1 no estaba corriendo."
  rm -f "$2"
}
cmd_stop() { stop_one "Oficina web" "$RUN/web.pid" "$WEB_PORT"; stop_one "Servidor" "$RUN/server.pid" "$PORT"; }

wa_port() { local u="${BACKOFFICE_WA_URL:-$(env_get BACKOFFICE_WA_URL)}"; u="${u:-http://127.0.0.1:8002}"; u="${u##*:}"; u="${u%%/*}"; case "$u" in ''|*[!0-9]*) echo 8002 ;; *) echo "$u" ;; esac; }

cmd_status() {
  healthy && say "Servidor:      corriendo (puerto $PORT)" || say "Servidor:      detenido (puerto $PORT)"
  web_up  && say "Oficina web:   corriendo -> http://localhost:$WEB_PORT" || say "Oficina web:   detenida (puerto $WEB_PORT)"
  local wp wh; wp="$(wa_port)"; wh="$(curl -fsS -m 2 "http://127.0.0.1:$wp/health" 2>/dev/null || true)"
  if [ -z "$wh" ]; then say "WhatsApp:      detenido (opcional: ./bin/backoffice whatsapp)"
  elif printf '%s' "$wh" | grep -q '"connected":true'; then say "WhatsApp:      conectado (puerto $wp)"
  else say "WhatsApp:      corriendo, esperando que escanees el QR (puerto $wp)"; fi
  local co; co="$(env_get BACKOFFICE_COMPANY)"
  [ -n "$co" ] && say "Empresa:       $co (plugin backoffice-$(env_get BACKOFFICE_COMPANY_SLUG))"
  say "Repo: $REPO"
}

# ---------- WhatsApp (opcional, no oficial) ----------
WA_VERSION="5.6.2"   # @open-wa/wa-automate fijado: el CLI cambia rápido entre versiones
rand_hex() { node -e 'process.stdout.write(require("crypto").randomBytes(24).toString("hex"))'; }

wa_ensure_env() {
  mkdir -p "$BACKOFFICE_HOME"
  local f="$BACKOFFICE_HOME/.env"
  [ -f "$f" ] || { ( umask 077; : >"$f" ); }
  chmod 600 "$f" 2>/dev/null || true
  [ -n "$(tail -c1 "$f" 2>/dev/null)" ] && printf '\n' >>"$f"
  [ -n "$(env_get BACKOFFICE_WA_URL)" ]            || printf 'BACKOFFICE_WA_URL=http://127.0.0.1:8002\n' >>"$f"
  [ -n "$(env_get BACKOFFICE_WA_API_KEY)" ]        || printf 'BACKOFFICE_WA_API_KEY=%s\n' "$(rand_hex)" >>"$f"
  [ -n "$(env_get BACKOFFICE_WA_WEBHOOK_SECRET)" ] || printf 'BACKOFFICE_WA_WEBHOOK_SECRET=%s\n' "$(rand_hex)" >>"$f"
  chmod 600 "$f" 2>/dev/null || true
}

wa_notice() {
  cat <<'TXT'

=====================  AVISO IMPORTANTE: WHATSAPP  =====================
Esto usa una herramienta NO OFICIAL (open-wa) que controla WhatsApp Web.
WhatsApp no la autoriza: tu número PUEDE SER BLOQUEADO.
  - Usa un número de prueba o un WhatsApp Business secundario, NO tu número principal.
  - Responde solo a personas que te escribieron primero. Nada de envíos masivos.
  - Los mensajes llegan a Back Office; el agente solo prepara borradores y TÚ los envías.
  - Todo corre en tu computadora (127.0.0.1); nada se expone a internet.
========================================================================
TXT
}

cmd_whatsapp() {
  local wa_home="$BACKOFFICE_HOME/whatsapp" accepted="$BACKOFFICE_HOME/whatsapp-accepted"
  if [ "${1:-}" = "--reset" ]; then
    printf 'Esto borra la sesión de WhatsApp guardada en %s y tendrás que escanear el QR otra vez.\n¿Continuar? (si/no): ' "$wa_home"
    local a; read -r a
    case "$a" in si|SI|Si|sí|Sí) rm -rf "$wa_home"; say "Sesión borrada.";; *) say "Cancelado.";; esac
    return 0
  fi
  command -v node >/dev/null 2>&1 || { say "No encuentro Node.js."; exit 1; }
  command -v npx  >/dev/null 2>&1 || { say "No encuentro npx (viene con Node.js)."; exit 1; }
  wa_ensure_env
  if [ ! -f "$accepted" ]; then
    wa_notice
    printf '\nEscribe «acepto» para continuar: '
    local a; read -r a
    case "$(printf '%s' "$a" | tr 'A-Z' 'a-z')" in acepto) date -u +%Y-%m-%dT%H:%M:%SZ >"$accepted" ;; *) say "No se aceptó. No se inició WhatsApp."; exit 1 ;; esac
  fi
  local url key secret wp
  url="$(env_get BACKOFFICE_WA_URL)"; key="$(env_get BACKOFFICE_WA_API_KEY)"; secret="$(env_get BACKOFFICE_WA_WEBHOOK_SECRET)"
  export BACKOFFICE_WA_URL="${url:-http://127.0.0.1:8002}"; wp="$(wa_port)"
  healthy || say "Aviso: el servidor Back Office no está corriendo. Abre otra terminal y corre: ./bin/backoffice start"
  if [ -n "$(port_pid "$wp")" ]; then say "El puerto $wp ya está en uso (¿WhatsApp ya está corriendo?)."; exit 1; fi
  mkdir -p "$wa_home"; chmod 700 "$wa_home" 2>/dev/null || true
  cat <<TXT

En tu teléfono abre WhatsApp > Dispositivos vinculados > Vincular dispositivo
y escanea el código QR que aparecerá aquí abajo (puede tardar un minuto).
Deja esta ventana abierta. Para detener WhatsApp: Ctrl+C.

TXT
  BACKOFFICE_WA_API_KEY="$key" BACKOFFICE_WA_WEBHOOK_SECRET="$secret" node "$REPO/scripts/whatsapp-bridge.mjs" &
  local bridge=$!
  trap 'kill "$bridge" 2>/dev/null' EXIT
  trap 'exit 130' INT TERM
  # --session-id agentos: the name of the saved WhatsApp session (kept from before the rename, or it would ask for the QR again).
  ( cd "$wa_home" && WA_API_KEY="$key" WA_SESSION_DATA_PATH="$wa_home" \
      npx -y "@open-wa/wa-automate@$WA_VERSION" --session-id agentos --host 127.0.0.1 --port "$wp" --no-dashboard )
}

cmd_update() {
  cd "$REPO" || exit 1
  # Marca para web/package.json (postinstall) y scripts/migrate-backoffice.mjs: este launcher ya migra todo él mismo.
  export BACKOFFICE_LAUNCHER=3
  say "Actualizando Back Office..."
  say "1/4 Bajando la versión nueva (git pull)..."
  git pull --ff-only || { say "No se pudo hacer git pull. Revisa tu conexión o avisa a tu instructor."; exit 1; }
  local was_web=0; web_up && was_web=1
  say "2/4 Deteniendo Back Office..."
  cmd_stop
  say "3/4 Instalando dependencias y compilando la oficina web..."
  (cd web && npm ci --no-audit --no-fund && NEXT_PUBLIC_BACKOFFICE_PORT="$PORT" node node_modules/next/dist/bin/next build) || { say "Falló la compilación."; exit 1; }
  # Un solo plugin `backoffice`: quita los viejos (agentos@agentos, los 7 de antes) si siguen, instala/actualiza
  # backoffice@backoffice, corrige ~/.claude/settings.json y Claude Desktop y, si quedaba algo con el nombre AgentOS,
  # respalda primero y lo renombra aquí mismo (data/agentos.db, variables, agentes editados). Idempotente.
  # Con empresa (BACKOFFICE_COMPANY en data/.env) también regenera e instala/actualiza su plugin backoffice-<empresa>.
  say "4/4 Actualizando el plugin de Back Office en Claude (y migrando lo que quede con el nombre AgentOS)..."
  node "$REPO/scripts/migrate-plugins.mjs" || say "Aviso: la migración de plugins no terminó. Vuelve a correr ./bin/backoffice update o mira «Actualizar» en CLAUDE.md."
  node "$REPO/scripts/build-mcpb.mjs" >/dev/null 2>&1 || true   # dist/backoffice[-<empresa>].mcpb (extensión de Claude Desktop, respaldo)
  say "Listo. Reinicia tus sesiones de Claude (y Claude Desktop) para cargar los cambios."
  [ "$was_web" = 1 ] && cmd_start
}

# Respaldo de data/ y workspaces/ en backups/backoffice-<fecha>/ (ignorado por git; se guardan los 3 más nuevos). La base se copia
# con el respaldo en línea de SQLite: sirve aunque Back Office esté corriendo. Lo pide el skill update-backoffice antes de actualizar.
cmd_backup() {
  [ -f "$REPO/scripts/backup-backoffice.mjs" ] || { say "Esta versión no trae scripts/backup-backoffice.mjs. Actualiza primero o pide «actualiza Back Office»."; exit 1; }
  node "$REPO/scripts/backup-backoffice.mjs" --dir "$REPO" --data "$BACKOFFICE_HOME" --workspaces "$BACKOFFICE_ROOT" "$@"
}

# Diagnóstico de solo lectura antes de actualizar (dónde están tus datos, versión local vs nueva, plan recomendado).
cmd_check() { node "$REPO/scripts/update-check.mjs" --dir "$REPO" "$@"; }

# Llave del MCP por HTTP (http://127.0.0.1:$PORT/mcp) para Codex, OpenCode, Cursor u otro cliente MCP.
# La crea si falta (data/mcp-key, solo tu usuario la puede leer) y dice dónde está; nunca la imprime.
cmd_mcp_key() {
  local f="$BACKOFFICE_HOME/mcp-key"
  BACKOFFICE_HOME="$BACKOFFICE_HOME" node --input-type=module -e "const m = await import(process.argv[1]); m.ensureMcpKey()" \
    "$(node -e 'process.stdout.write(require("url").pathToFileURL(process.argv[1]).href)' "$REPO/plugins/backoffice/server/src/auth.mjs")" \
    || { say "No pude crear la llave en $f."; exit 1; }
  say "Llave del MCP de Back Office: $f"
  say "(no la compartas ni la pegues en un chat; solo va en la configuración de tu cliente MCP)"
  say ""
  say "Cópiala al portapapeles:"
  say "  macOS:  pbcopy < \"$f\""
  say "  Linux:  xclip -selection clipboard < \"$f\""
  say ""
  say "En tu cliente MCP agrega un servidor HTTP:"
  say "  URL:     http://127.0.0.1:$PORT/mcp"
  say "  Header:  Authorization: Bearer <pega aquí la llave>"
  say "Guía por cliente (Codex, OpenCode, Cursor): docs/API.md"
}

case "${1:-}" in
  start) cmd_start ;; stop) cmd_stop ;; status) cmd_status ;; update) cmd_update ;;
  whatsapp) shift; cmd_whatsapp "$@" ;;
  mcp-key) cmd_mcp_key ;;
  backup) shift; cmd_backup "$@" ;;
  check) shift; cmd_check "$@" ;;
  *) say "Uso: ./bin/backoffice {start|stop|status|update|backup|check|mcp-key|whatsapp [--reset]}"; exit 2 ;;
esac
