#!/usr/bin/env bash
# AgentOS ahora se llama Back Office. Este comando sigue funcionando por una versión: le pasa todo a bin/backoffice.
# (Compatibilidad: quítalo cuando todos usen ./bin/backoffice.)
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  D="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$D/$SELF" ;; esac
done
exec "$(cd "$(dirname "$SELF")" && pwd)/backoffice" "$@"
